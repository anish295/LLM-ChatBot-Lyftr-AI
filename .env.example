# =============================================================================
# LLM Chatbot with Key Failover and Response Caching - configuration
# Copy to .env and fill in real values:   cp .env.example .env
# Real keys never go in the repo.
# =============================================================================

# --- LLM provider (any LiteLLM model id; ALL keys below must belong to it) ---
# Default: Groq (free tier, keys at https://console.groq.com/keys)
LLM_MODEL=groq/openai/gpt-oss-120b
# Other Groq presets:
# LLM_MODEL=groq/openai/gpt-oss-20b
# LLM_MODEL=groq/qwen/qwen3.8-27b
# Gemini presets (keys at https://aistudio.google.com/apikey):
# LLM_MODEL=gemini/gemini-flash-latest
# LLM_MODEL=gemini/gemini-2.0-flash   (older ids may be closed to new API users)
# LLM_MODEL=gemini/gemini-2.5-flash

# Comma-separated key pool, at least 2 keys. Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your_key_1,your_key_2

# Optional: reasoning effort for reasoning models (low|medium|high). Leave empty
# for non-reasoning models; unsupported params are dropped by LiteLLM.
LLM_REASONING_EFFORT=low

# Sampling / limits (temperature 0 = deterministic, cache-friendly output)
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# Default system prompt (kept short to save tokens; identical for every new session)
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# --- Storage ---------------------------------------------------------------
# SQLite file. Inside Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db

# --- Cache (LiteLLM built-in) ----------------------------------------------
# disk  = LiteLLM DiskCache under CACHE_DIR (survives restarts with the volume)
# local = LiteLLM in-memory cache (lost on restart)
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
# Cache TTL in seconds (0 = never expire)
CACHE_TTL_SECONDS=0

# --- HTTP --------------------------------------------------------------------
# Comma-separated CORS origins (exact match, no trailing slash needed)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Optional regex (full match) for extra origins, e.g. Netlify per-deploy URLs:
# ALLOWED_ORIGIN_REGEX=https://([a-z0-9]+--)?your-site\.netlify\.app
ALLOWED_ORIGIN_REGEX=
PORT=8000
# Host ports used by docker compose (container ports stay 8000/3000).
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO

# --- Resilience --------------------------------------------------------------
# true enables the X-Simulate-Failure test hook (must be true on the deployed backend)
ENABLE_FAILURE_SIMULATION=true
# Skip a key for N seconds after a real 429 (0 disables). Never applied to simulated requests.
KEY_COOLDOWN_SECONDS=30
# Per-IP limit on POST /chat (requests per minute, 0 disables). Generous by design.
RATE_LIMIT_PER_MINUTE=120

# --- Frontend (build-time) ---------------------------------------------------
# Base URL the React app calls. Baked in at build time.
VITE_API_BASE_URL=http://localhost:8000
